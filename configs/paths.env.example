# Copy this file to configs/paths.env and edit the values.

# Data. Download MIMIC-CXR-JPG from PhysioNet:
#   https://physionet.org/content/mimic-cxr-jpg/2.1.0/
# Download LLaVA-Rad/CheXGenBench annotations from PhysioNet:
#   https://physionet.org/content/llava-rad-mimic-cxr-annotation/1.0.0/
# The CSV schema is documented in docs/DATA.md.
TRAIN_CSV=/path/to/LLAVARAD_ANNOTATIONS_TRAIN.csv
VAL_CSV=/path/to/LLAVARAD_ANNOTATIONS_TEST.csv
REAL_CXR_CSV=/path/to/training_data_20K.csv
REAL_CXR_ROOT=/path/to/mimic-cxr-jpg

# Models may be Hugging Face IDs or local snapshot directories. Download links:
#   https://huggingface.co/Qwen/Qwen3-4B-Thinking-2507
#   https://huggingface.co/raman07/CheXGenBench-Models-Sana-e20
#   https://huggingface.co/microsoft/BiomedVLP-BioViL-T
#   https://huggingface.co/microsoft/rad-dino
MODEL_PATH=Qwen/Qwen3-4B-Thinking-2507
SANA_MODEL_PATH=raman07/CheXGenBench-Models-Sana-e20
BIOVIL_T_PATH=microsoft/BiomedVLP-BioViL-T
RAD_DINO_PATH=microsoft/rad-dino

# Local reward assets.
CXR_CLASSIFIER_CHECKPOINT=/path/to/best_classifier.pt
RADDINO_REFERENCE_CACHE=/path/to/raddino_train20k_ref.npz

# Five-GPU paper layout: two policy GPUs and three rendering/reward GPUs.
LLM_CUDA_VISIBLE_DEVICES=0,1
REWARD_CUDA_VISIBLE_DEVICES=2,3,4
